{
  "expo": {
    "name": "harna.usta.uz",
    "slug": "mobile-app-afish",
    "scheme": ["harna-worker", "harnaworker"],
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/d45371fb-bf89-4d60-914e-6ca325c91aa3",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#0c1828",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "uz.harna.usta",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "uz.harna.usta",
      "versionCode": 3,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "harna.usta.uz", "pathPrefix": "/r/" },
            { "scheme": "https", "host": "harna.usta.uz", "pathPrefix": "/mutaxassis/" },
            { "scheme": "https", "host": "harna.usta.uz", "pathPrefix": "/usta/" },
            { "scheme": "https", "host": "harna.usta.uz", "pathPrefix": "/listings/" },
            { "scheme": "https", "host": "harna.usta.uz", "pathPrefix": "/ish/" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Karta raqamini o'qish va rasm olish uchun kameradan foydalaniladi.",
          "photosPermission": "Profil va e'lon rasmlarini tanlash uchun galereyadan foydalaniladi.",
          "microphonePermission": false
        }
      ],
      "expo-location",
      "expo-secure-store",
      "expo-image",
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Ilova hisobingizga xavfsiz kirish uchun Face ID dan foydalanadi."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-dontwarn expo.modules.kotlin.types.ColorCompat**"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#f97316",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0c1828",
          "image": "./assets/logo-on-dark.png",
          "imageWidth": 220
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d45371fb-bf89-4d60-914e-6ca325c91aa3"
      }
    },
    "owner": "shakhandijan"
  }
}
